#!/usr/bin/env bash
set -euo pipefail
if [[ "$(uname -s)" == Darwin ]]; then
    export TMPDIR=/private/tmp
fi

project_root="$(git rev-parse --show-toplevel)"
cd -- "$project_root"
commit_index="$(git rev-parse --path-format=absolute --git-path index)"
snapshot="$(mktemp -d "${TMPDIR:-/tmp}/notion-pre-commit.XXXXXX")"
snapshot="$(cd -- "$snapshot" && pwd)"
trap 'rm -rf -- "$snapshot"' EXIT
git checkout-index --all --prefix="$snapshot/"
git_local_variables="$(git rev-parse --local-env-vars)"
while IFS= read -r variable; do
    unset "$variable"
done <<< "$git_local_variables"

export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$project_root/target}"
if [[ "$CARGO_TARGET_DIR" != /* ]]; then
    export CARGO_TARGET_DIR="$project_root/$CARGO_TARGET_DIR"
fi
cd -- "$snapshot"
printf '%s\n' '[提交前检查] 正在运行统一提交前检查……'
if ! GIT_INDEX_FILE="$commit_index" ./scripts/check --pre-commit \
    --baseline-repository "$project_root"; then
    printf '%s\n' '[提交已阻止] 项目提交前检查未通过或无法运行。按检查建议处理后重新暂存，再次提交。' >&2
    exit 1
fi
printf '%s\n' '[提交前检查] 正在运行 Clippy……'
if ! cargo clippy --all-targets --locked --offline -- -D warnings; then
    printf '%s\n' '[提交已阻止] Clippy 检查未通过或无法运行。修复后重新暂存，再次提交。' >&2
    exit 1
fi
printf '%s\n' '[提交前测试] 正在离线测试暂存区中的代码……'
if cargo test --locked --offline -- --test-threads=1; then
    printf '%s\n' '[提交前测试] 全部通过，允许提交。'
else
    printf '%s\n' '[提交已阻止] 测试未通过或无法运行。修复后重新暂存，再次提交。' >&2
    exit 1
fi
