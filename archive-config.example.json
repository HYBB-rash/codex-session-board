{
  "version": 1,
  "enabled": false,
  "workspace": ".",
  "data_dir": "data",
  "task_workspace_root": "tasks",
  "archive_data_dir": "data/archive-runtime",
  "worker_cwd": ".",
  "data_source_id": "REPLACE_WITH_TASK_DATA_SOURCE_UUID",
  "project_data_source_id": "REPLACE_WITH_PROJECT_DATA_SOURCE_UUID",
  "executor": "Fedora Codex",
  "daemon_socket": "/path/to/app-server-control.sock",
  "mcp_server": "codex_apps",
  "tools": {
    "fetch": "notion.fetch",
    "query": "notion.query-data-sources",
    "update": "notion.notion-update-page",
    "create": "notion.notion-create-pages"
  },
  "analysis_model": "group/gpt-6-astra",
  "request_timeout_seconds": 60,
  "analysis_timeout_seconds": 900,
  "retry_delays_seconds": [60, 180, 300],
  "recovery_probe_seconds": 3600,
  "max_source_pages": 64,
  "max_source_chars": 300000,
  "exception_parent_page_id": "REPLACE_WITH_EXCEPTION_PARENT_UUID"
}
