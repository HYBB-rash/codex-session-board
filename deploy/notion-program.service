[Unit]
Description=Notion Rust task dispatcher
After=network-online.target
OnFailure=notion-program-failure.service

[Service]
Type=oneshot
WorkingDirectory=%h/文档/notion-program
ExecStart="%h/文档/notion-program/target/release/notion-program" --config "%h/文档/notion-program/config.json" --trigger timer run
TimeoutStartSec=infinity
UMask=0077
