#!/usr/bin/bash
set -euo pipefail

script="${BASH_SOURCE[0]}"
while [ -L "$script" ]; do
    dir="$(CDPATH= cd -- "$(dirname -- "$script")" && pwd)"
    target="$(readlink -- "$script")"
    case "$target" in
        /*) script="$target" ;;
        *) script="$dir/$target" ;;
    esac
done
root="$(CDPATH= cd -- "$(dirname -- "$script")/../.." && pwd)"
cd "$root"

max_files=15
max_lines=400
file_count=0
line_count=0
ignored_file() {
    local file="$1"
    case "$file" in
        package-lock.json) return 0 ;;
        acceptance/model.py|acceptance/requirements.json)
            local actual expected
            case "$file" in
                acceptance/model.py)
                    expected=afc587078c415ccb631fed4efdcef304269096fbfece812e680a6d4e195738d7 ;;
                acceptance/requirements.json)
                    expected=5b20b6135b59c3daf4002bea17316c0fbaf80228cd822e24ffb9853a4d69c32b ;;
            esac
            actual="$(git show ":$file" 2>/dev/null | sha256sum)"
            test "${actual%% *}" = "$expected" ;;
        src/migration/projection.ts|src/migration/legacy.test.ts|acceptance/candidate-map.json)
            if git cat-file -e "HEAD:$file" 2>/dev/null; then return 1; fi
            local staged
            IFS= read -r staged < <(git diff --cached --name-only)
            test "$staged" = "$file" && test "$(git diff --cached --name-only | wc -l)" -eq 1 ;;
        *) return 1 ;;
    esac
}
while IFS=$'\t' read -r added deleted file; do
    file_count=$((file_count + 1))
    if ignored_file "$file"; then continue; fi
    if [ "$added" != "-" ]; then
        line_count=$((line_count + added))
    fi
    if [ "$deleted" != "-" ]; then
        line_count=$((line_count + deleted))
    fi
done < <(git diff --cached --numstat)

failed=0
if [ "$file_count" -gt "$max_files" ] || [ "$line_count" -gt "$max_lines" ]; then
    printf '提交被拒绝：暂存了 %s 个文件，新增和删除一共 %s 行，上限是 %s 个文件、%s 行。\n' \
        "$file_count" "$line_count" "$max_files" "$max_lines" >&2
    failed=1
fi

if ! npm run lint --silent; then
    printf '提交被拒绝：format 或 lint 没有通过。\n' >&2
    failed=1
fi

exit "$failed"
