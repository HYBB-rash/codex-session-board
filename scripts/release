#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
release_entry=scripts/release_plugin.py
if [[ "${1:-}" == main ]]; then
  release_entry=scripts/main_release.py
  shift
fi
delivery_python="${XDG_DATA_HOME:-$HOME/.local/share}/codex-session-board/delivery-venv/bin/python"
if [[ -x "$delivery_python" ]]; then
  exec "$delivery_python" "$release_entry" "$@"
fi
exec python3 "$release_entry" "$@"
