{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": ["node", "vite/client"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "jsx": "preserve",
        "jsxImportSource": "vue",
        "allowImportingTsExtensions": true
    },
    "include": ["**/*.ts", "**/*.tsx", "**/*.vue", "../runtime/electron.d.ts"]
}
